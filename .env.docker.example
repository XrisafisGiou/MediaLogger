# Name this file to .env.docker and replace every placeholder value.

POSTGRES_DB=medialogger
POSTGRES_USER=medialogger
POSTGRES_PASSWORD=change_this_database_password

DATABASE_URL=postgresql://medialogger:change_this_database_password@database:5432/medialogger?schema=public

JWT_SECRET=replace_with_a_long_random_secret

TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your_tmdb_api_key

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
IGDB_BASE_URL=https://api.igdb.com/v4

# Optional but recommended so requests identify your application.
OPEN_LIBRARY_CONTACT_EMAIL=your_email@example.com
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

PORT=3000
